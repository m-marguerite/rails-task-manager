<div class="container my-4">
  <h1>My tasks</h1>

  <ul class="list-unstyled">
    <% @tasks.each do |task| %>
      <li class="d-flex align-items-center gap-2">
        <% if task.completed %>
          <i class="fa-regular fa-square-check"></i>
        <% else %>
          <i class="fa-regular fa-square"></i>
        <% end %>

        <%= link_to task.title, task_path(task), class: "text-decoration-none" %>
        <span>·</span>

        <%= button_to task_path(task),
              method: :delete,
              class: "btn btn-link p-0 text-decoration-none",
              form: { class: "d-inline", data: { turbo_confirm: "Delete #{task.title}?" } } do %>
          <i class="fa-solid fa-trash-can"></i>
        <% end %>
      </li>
    <% end %>
  </ul>

  <hr>

  <%= link_to new_task_path, class: "text-decoration-none" do %>
    <i class="fa-solid fa-plus"></i> Add a new task
  <% end %>
</div>
