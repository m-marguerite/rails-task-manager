<div class="container my-4">
  <h2><%= @task.title %></h2>
  <div class="card" style="background-color:#E0E0E0">
    <div class="card-body">
      <p><%= @task.details %></p>
    </div>
  </div>

  <div class="mt-4">
    <% if @task.completed %>
      <p>
        <i class="fa-regular fa-square-check"></i>
        This task is completed
      </p>
    <% else %>
      <p>
        <i class="fa-regular fa-square"></i>
        This task is completed
      </p>
    <% end %>
  </div>

  <hr>

  <%= link_to tasks_path, class: "text-decoration-none" do %>
    <i class="fa-solid fa-arrow-left"></i> Back to list
  <% end %>

  <hr>

  <%= link_to edit_task_path, class: "text-decoration-none" do %>
    <i class="fa-solid fa-pen-to-square"></i> Edit this task
  <% end %>
</div>
